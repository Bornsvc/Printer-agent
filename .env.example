# Copy this file to .env and fill in real values.

# Your DigitalOcean-hosted app URL (no trailing slash)
API_URL=https://yourapp.com

# Must exactly match PRINT_AGENT_SECRET in the Next.js app's .env.local
AGENT_SECRET=

# How often (in ms) to poll for new print jobs. Optional — defaults to 3000.
POLL_INTERVAL_MS=3000

# If a RECEIPT/KOT print fails, the agent retries up to PRINT_RETRY_ATTEMPTS
# times, spread evenly across PRINT_RETRY_WINDOW_MS. If every attempt still
# fails (printer genuinely offline), the job is marked FAILED and left alone
# — it shows up under "Failed print jobs" on /admin/printers, where staff can
# hit Retry to requeue it once the printer is back. Other stations keep
# printing normally the whole time — this only blocks the one station.
# Optional — defaults: 3 attempts spread over 6 minutes (360000ms).
PRINT_RETRY_ATTEMPTS=3
PRINT_RETRY_WINDOW_MS=360000

# Fixed delay (ms) between attempts for the cash-drawer kick retry below —
# unrelated to the RECEIPT/KOT retry window above. Optional — defaults to 3000.
PRINT_RETRY_DELAY_MS=3000

# The cash-drawer kick after a receipt prints is best-effort and still uses a
# bounded retry (won't hold up acking the receipt as PRINTED). Optional —
# defaults to 3 attempts.
DRAWER_RETRIES=3

# Cooldown enforced between two jobs sent to the SAME physical printer, so the
# next job's connection doesn't start while the printer is still mid-cut on
# the previous one (execute() resolving only means the bytes were sent, not
# that the printer finished printing/cutting). Raise this if papers still
# come out missing/corrupted after a burst of orders — e.g. a multi-item
# order sends several KOT jobs to the same kitchen station back to back.
# Optional — defaults to 3000ms.
PRINT_GAP_MS=3000

# Printer IPs are managed from /admin/printers in the web app — no printer
# IPs need to be set here, the agent fetches them automatically.

# - pm2 status — check it's running
# - pm2 logs printer-agent — tail logs
# - pm2 restart printer-agent — restart after code changes
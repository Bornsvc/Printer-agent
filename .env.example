# Copy this file to .env and fill in real values.

# Your DigitalOcean-hosted app URL (no trailing slash)
API_URL=https://yourapp.com

# This restaurant's agent key — must exactly match its Tenant.agentKey row
# in the app's database (each restaurant/tenant has its own; no longer a
# single shared PRINT_AGENT_SECRET for the whole deployment).
AGENT_SECRET=

# How often (in ms) to poll for new print jobs. Optional — defaults to 3000.
POLL_INTERVAL_MS=3000

# Automatic retry (see index.js). If a printer can't be reached, the job waits
# and is retried after PRINT_RETRY_DELAYS_MS (comma-separated; the last value
# repeats) — without holding up other tickets for the same printer. After 3
# unreachable attempts in a row the printer is paused until it answers again
# (30s health check) or BREAKER_PROBE_MS passes, then the waiting tickets print
# oldest-first. The web app stops tickets that wait too long (kitchen tickets
# after 15 min) and lists them, plus any ticket that may or may not have
# printed, under "Print jobs needing attention" on /admin/printers.
# Optional — defaults: 5000,15000,45000,60000 and 60000ms.
PRINT_RETRY_DELAYS_MS=5000,15000,45000,60000
BREAKER_PROBE_MS=60000

# Cooldown enforced between two jobs sent to the SAME physical printer, so the
# next job's connection doesn't start while the printer is still mid-cut on
# the previous one (execute() resolving only means the bytes were sent, not
# that the printer finished printing/cutting). Raise this if papers still
# come out missing/corrupted after a burst of orders — e.g. a multi-item
# order sends several KOT jobs to the same kitchen station back to back.
# Optional — defaults to 3000ms.
PRINT_GAP_MS=3000

# Language of the fixed labels printed on receipts / kitchen tickets
# ("Table", "Total", "Thank you", ...) and of menu item names: th, lo or en.
# Item names print in this language when the menu item has a translation for
# it in the web app, otherwise in the base (Thai) name. Notes and the
# restaurant name print as entered. Optional — defaults to th. Restart the
# agent after changing (pm2 restart printer-agent).
PRINT_LANGUAGE=th

# Currency symbol/decimals on receipts: THB (฿), LAK (₭) or USD ($).
# Optional — when unset, each receipt uses the restaurant's own currency from
# /admin/settings in the web app (THB if the app doesn't send one). Set it to
# force this printer to one currency regardless.
# PRINT_CURRENCY=LAK

# Printer IPs are managed from /admin/printers in the web app — no printer
# IPs need to be set here, the agent fetches them automatically.

# - pm2 status — check it's running
# - pm2 logs printer-agent — tail logs
# - pm2 restart printer-agent — restart after code changes